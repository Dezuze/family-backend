[Unit]
Description=KFA Daily Anniversary Post Generator
After=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/kfa/Backend
EnvironmentFile=/opt/kfa/Backend/.env
ExecStart=/opt/kfa/Backend/.venv/bin/python manage.py generate_anniversary_posts

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
